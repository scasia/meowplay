<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_carplay"
            android:contentDescription="CarPlay" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/adapter_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGlobalStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2230D158"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="READY"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stereo Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="@string/weblink_header"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvStereoStatus"
                    android:text="@string/status_not_connected"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvStereoDetails"
                    android:text="Awaiting USB connection to Pioneer DMH-A240BT…"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- CarPlay Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="@string/carplay_header"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCarPlayStatus"
                    android:text="@string/carplay_waiting"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvCarPlayDetails"
                    android:text="Wi-Fi Hotspot: Initializing | Ed25519 MFi Authenticated"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Wi-Fi Connection & Hotspot Settings Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="CARPLAY WI-FI CONNECTION SETTINGS"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <!-- Radio Group: Hotspot vs Wi-Fi Direct -->
                <RadioGroup
                    android:id="@+id/rgWifiMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbModeHotspot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wi-Fi Hotspot"
                        android:textColor="@color/text_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbModeDirect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wi-Fi Direct (P2P)"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <!-- Manual Hotspot Credentials Container -->
                <LinearLayout
                    android:id="@+id/layoutHotspotCredentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Hotspot SSID (Network Name):"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp" />

                    <EditText
                        android:id="@+id/etHotspotSsid"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="#2C2F36"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingHorizontal="10dp"
                        android:hint="e.g. CarPlay-WebLink"
                        android:textColorHint="@color/text_muted"
                        android:singleLine="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:text="Hotspot Password (8+ characters):"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp" />

                    <EditText
                        android:id="@+id/etHotspotPassword"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="#2C2F36"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingHorizontal="10dp"
                        android:hint="e.g. 12345678"
                        android:textColorHint="@color/text_muted"
                        android:singleLine="true"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSaveHotspot"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Save &amp; Apply"
                            android:backgroundTint="@color/accent_blue"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnOpenHotspotSettings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Hotspot Settings"
                            android:backgroundTint="#3A3D45"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:text="Tip: In Hotspot mode, turn on your Android Personal Hotspot with the SSID and password above. The iPhone connects reliably without Wi-Fi Direct handshake drops."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>

            <!-- Touch Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="@string/touch_header"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTouchStatus"
                    android:text="No touch events received yet"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Diagnostic Log Window -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:text="DIAGNOSTIC LOG"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Copy Logs"
                    android:textSize="10sp"
                    android:paddingHorizontal="10dp"
                    android:backgroundTint="#3A3D45"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="Clear"
                    android:textSize="10sp"
                    android:paddingHorizontal="10dp"
                    android:backgroundTint="#3A3D45"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLogs"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/log_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#30D158"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:text="[Adapter] System initialized.\n" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_service"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnForceKeyFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Request IDR"
            android:backgroundTint="@color/card_bg"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
